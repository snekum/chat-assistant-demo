# Copy to .env and fill in your own keys. .env is gitignored -- NEVER commit it.
#   cp .env.example .env

# Anthropic key. REQUIRED only for the online lanes (generation + LLM judge).
# The offline retrieval/hit-rate lanes run without it -- eval/run.py just skips the
# generate+judge lanes and writes null for those fields.
ANTHROPIC_API_KEY=

# Optional. Only needed for the (unbuilt) cross-provider generator/judge bake-off.
# Leave blank unless you are wiring those backends.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Postgres DSN override. Defaults (in src/store.py) to the docker-compose service:
#   PG_DSN=postgresql://postgres:postgres@localhost:5432/portfolio
# PG_DSN=

# Optional: point the harness at a different question set (defaults to eval/questions.jsonl).
# EVAL_QUESTIONS=eval/questions.jsonl
